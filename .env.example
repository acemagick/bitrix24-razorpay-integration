# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is in .gitignore. Never commit real keys.

# ----------------------------------------------------------------- Bitrix24
# Inbound webhook URL (Developer resources -> Other -> Inbound webhook, with "CRM" scope).
# The last part of the URL is a secret token, so treat it like a password.
BITRIX_WEBHOOK_URL=https://yourcompany.bitrix24.in/rest/1/abcdef1234567890/

# API names of two custom deal fields (type: string). Find them with:  npm run list-fields
BITRIX_PAYMENT_LINK_FIELD=UF_CRM_1234567890
BITRIX_PAYMENT_ID_FIELD=UF_CRM_1234567891

# ----------------------------------------------------------------- Razorpay (TEST MODE)
# Dashboard (Test Mode toggle ON) -> Account & Settings -> API Keys.
# Test keys start with rzp_test_. For live mode, swap in rzp_live_ keys.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_key_secret

# The secret you type when creating the webhook (Dashboard -> Account & Settings -> Webhooks).
# Test and live mode have separate webhooks, so each has its own secret.
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# ----------------------------------------------------------------- Behaviour
# Move the deal to "Won" when its payment link is fully paid (true/false).
MOVE_DEAL_TO_WON=false

# Optional. If set, POST /payment-links requires ?token=<this value>.
INBOUND_API_TOKEN=

# Optional. Allow customers to pay in parts (needed for payment_link.partially_paid).
RAZORPAY_ACCEPT_PARTIAL=false

# Optional. Days until a link expires (needed for payment_link.expired). Empty = never expires.
PAYMENT_LINK_EXPIRE_DAYS=

# Optional. Where processed webhook event IDs are stored, and the HTTP port.
PROCESSED_EVENTS_PATH=data/processed_events.json
# Optional. Where links that were created but couldn't be saved to the deal or cancelled are remembered.
UNRESOLVED_LINKS_PATH=data/unresolved_links.json
PORT=8000
