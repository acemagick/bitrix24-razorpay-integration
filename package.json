{
  "name": "bitrix24-razorpay-integration",
  "version": "1.0.0",
  "description": "Creates Razorpay payment links for Bitrix24 deals and posts payment status back to the deal timeline.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "list-fields": "tsx scripts/listFields.ts",
    "check-setup": "tsx scripts/checkSetup.ts",
    "send-webhook": "tsx scripts/sendTestWebhook.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acemagick/bitrix24-razorpay-integration.git"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "big.js": "^7.0.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
